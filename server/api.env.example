# The API's environment. In production the whole file is the PROD_ENV
# CI/CD variable in GitLab (Settings > CI/CD > Variables, protected); the
# pipeline writes it to /opt/pdf-editor/api.env on the manager. Never commit
# the real file: it holds the database and SMTP passwords.

PORT=3000
HOST=0.0.0.0

# MySQL. In production this is the shared server, reached through proxysql on
# the db-network overlay. The user needs DDL rights: the API creates its own
# tables on first start.
DB_HOST=proxysql
DB_PORT=6033
DB_NAME=pdf_editor
DB_USERNAME=pdf_editor
DB_PASSWORD=

# The site the app is served from. Links in emails point here, and it is the
# only Origin accepted on write requests.
APP_ORIGIN=https://pdf-editor.eightmile.co.uk

SESSION_TTL_DAYS=30
SECURE_COOKIES=true

# The shared proxy plus the app container's nginx: two hops in front of us.
TRUST_PROXY_HOPS=2

# Outgoing mail (confirmation and password reset).
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Eight Mile PDF <no-reply@eightmile.co.uk>

LOG_LEVEL=info
